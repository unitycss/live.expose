# Set this in Vercel → Project Settings → Environment Variables.
# It's the password your owner console uses to authenticate uploads/deletes.
OWNER_KEY=choose-a-long-random-string

# Created automatically when you enable "Blob" storage on the Vercel project
# (Storage tab → Create Database → Blob). Vercel injects this for you;
# you normally don't set it by hand.
BLOB_READ_WRITE_TOKEN=
